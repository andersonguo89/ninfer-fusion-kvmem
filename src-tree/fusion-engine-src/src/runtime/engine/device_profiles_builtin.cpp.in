#include "runtime/engine/device_profiles_builtin.h"

namespace ninfer::runtime {

// Generated from src/runtime/engine/device_profiles.json at configure time.
std::string_view compiled_device_route_profiles_json() {
    return R"ninfer_a(@NINFER_DEVICE_PROFILES_JSON_A@)ninfer_a"
           R"ninfer_b(@NINFER_DEVICE_PROFILES_JSON_B@)ninfer_b";
}

} // namespace ninfer::runtime
